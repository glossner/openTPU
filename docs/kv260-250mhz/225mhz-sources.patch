diff --git a/boards/kv260/build.py b/boards/kv260/build.py
new file mode 100644
index 0000000000000000000000000000000000000000..b06ffbfa8d639f7d25e8185759ebe2e1c76bb9bf
--- /dev/null
+++ b/boards/kv260/build.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Capture inputs and build a KV260 bitstream. Never opens a hardware server."""
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+from opentpu import target as T
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--mhz", type=float, default=200)
+    p.add_argument("--out", type=Path)
+    p.add_argument("--stage", choices=("full", "synth"), default="full")
+    p.add_argument("--reference-dcp", type=Path,
+                   help="routed checkpoint used only as an incremental placement/routing reference")
+    a = p.parse_args()
+    if not 50 <= a.mhz <= 500:
+        p.error("--mhz must be between 50 and 500")
+    reference = a.reference_dcp.resolve() if a.reference_dcp else None
+    if reference and (not reference.is_file() or reference.suffix != ".dcp"):
+        p.error("--reference-dcp must name an existing routed .dcp file")
+    vivado = (os.environ.get("VIVADO_BIN") or shutil.which("vivado")
+              or "/home/jglossner/Xilinx/2026.1/Vivado/bin/vivado")
+    if not Path(vivado).is_file():
+        p.error("Vivado unavailable; set VIVADO_BIN")
+    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+    cache = ROOT / ".tmp/kv260/vendor-ip-cache"
+    cache.mkdir(parents=True, exist_ok=True)
+    out = (a.out or ROOT / ".tmp/kv260" / f"{stamp}-{a.mhz:g}mhz").resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    snap = out / "inputs"
+    t = T.load("kv260")
+    rels = [f"rtl/{f}" for f in T.sources(t)] + [
+        "targets/kv260.toml", "boards/kv260/build.py", "boards/kv260/vivado/build.tcl",
+        "boards/kv260/constraints/kv260.xdc", "opentpu/target.py"]
+    hashes = {}
+    for rel in rels:
+        dst = snap / rel
+        dst.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copyfile(ROOT / rel, dst)
+        hashes[rel] = hashlib.sha256(dst.read_bytes()).hexdigest()
+    head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
+    build_id = hashlib.sha256(json.dumps(dict(files=hashes, core_mhz=a.mhz, target="kv260"),
+                                        sort_keys=True).encode()).hexdigest()[:8]
+    manifest = dict(created_utc=stamp, git_head=head, mhz=a.mhz, stage=a.stage,
+                    target="kv260", arch_hash=f"{T.arch_hash(T.config(t)):08x}",
+                    build_id=build_id, files=hashes, load_requested=False,
+                    vendor_ip_cache=str(cache))
+    if reference:
+        captured_reference = snap / "implementation_reference.dcp"
+        shutil.copyfile(reference, captured_reference)
+        manifest["incremental_reference"] = dict(
+            original_path=str(reference), captured_path="inputs/implementation_reference.dcp",
+            sha256=hashlib.sha256(captured_reference.read_bytes()).hexdigest())
+    # A source file per line, paths relative to the immutable input root.
+    (out / "sources.txt").write_text("".join(f"rtl/{f}\n" for f in T.sources(t)))
+    (out / "config.tcl").write_text(
+        f"set core_mhz {a.mhz}\nset build_id 0x{build_id}\n"
+        f"set arch_hash 0x{T.arch_hash(T.config(t)):08x}\nset build_stage {a.stage}\n"
+        f"set incremental_reference {int(reference is not None)}\n")
+    manifest["config_sha256"] = hashlib.sha256((out / "config.tcl").read_bytes()).hexdigest()
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    env = dict(os.environ, TMPDIR=str(out / "tmp"), OTPU_KV260_IP_CACHE=str(cache))
+    (out / "tmp").mkdir()
+    cmd = [vivado, "-mode", "batch", "-nojournal", "-log", str(out / "vivado.log"),
+           "-source", str(snap / "boards/kv260/vivado/build.tcl"), "-tclargs", str(out)]
+    print(f"KV260_BUILD={out}", flush=True)
+    with (out / "console.log").open("w") as log:
+        proc = subprocess.Popen(cmd, cwd=out, env=env, stdout=log, stderr=subprocess.STDOUT)
+        (out / "process.json").write_text(json.dumps(dict(pid=proc.pid, command=cmd), indent=2))
+        rc = proc.wait()
+        # Preserve the real exit before interpreting reports or success markers.
+        (out / "exit.json").write_text(json.dumps(dict(returncode=rc,
+            finished_utc=dt.datetime.now(dt.timezone.utc).isoformat()), indent=2) + "\n")
+    print(f"VIVADO_EXIT={rc} KV260_BUILD={out}", flush=True)
+    return rc if rc else (0 if (out / ("PASS" if a.stage == "full" else "SYNTH_PASS")).exists() else 1)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/boards/kv260/constraints/kv260.xdc b/boards/kv260/constraints/kv260.xdc
new file mode 100644
index 0000000000000000000000000000000000000000..05fb7eee357e3a375fae2614bf0f18af5ae3aaf9
