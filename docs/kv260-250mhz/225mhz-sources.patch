@@ -0,0 +1,7 @@
+# KV260 carrier fan: AMD kria-vitis-platforms kv260_bist/xdc/pin.xdc.
+set_property PACKAGE_PIN A12 [get_ports fan_en_b]
+set_property IOSTANDARD LVCMOS33 [get_ports fan_en_b]
+set_property SLEW SLOW [get_ports fan_en_b]
+set_property DRIVE 4 [get_ports fan_en_b]
+set_property BITSTREAM.CONFIG.OVERTEMPSHUTDOWN ENABLE [current_design]
+# PS/Clock Wizard generated constraints define clocks. Every accelerator path is timed.
diff --git a/boards/kv260/vivado/build.tcl b/boards/kv260/vivado/build.tcl
new file mode 100644
index 0000000000000000000000000000000000000000..cfe30a7b077f485603acc2d7f5de7ba9e451497a
--- /dev/null
+++ b/boards/kv260/vivado/build.tcl
@@ -0,0 +1,262 @@
+# Build only: this script contains no hardware-manager or programming commands.
+if {$argc != 1} {error "usage: build.tcl OUTPUT_DIRECTORY"}
+set out [file normalize [lindex $argv 0]]
+set inputs [file join $out inputs]
+source [file join $out config.tcl]
+set_param general.maxThreads 4
+proc record {path data} {set f [open $path w]; puts $f $data; close $f}
+proc one {objects description} {
+    if {[llength $objects] != 1} {error "Expected one $description, got $objects"}
+    return [lindex $objects 0]
+}
+proc pin {name} {return [one [get_bd_pins -quiet $name] "pin $name"]}
+proc net {src args} {
+    set p [list [pin $src]]
+    foreach dst $args {lappend p [pin $dst]}
+    connect_bd_net {*}$p
+}
+proc intf {src dst} {
+    connect_bd_intf_net [get_bd_intf_pins $src] [get_bd_intf_pins $dst]
+}
+proc ip {name vlnv props} {
+    set obj [create_bd_cell -type ip -vlnv $vlnv $name]
+    if {[llength $props]} {set_property -dict $props $obj}
+    return $obj
+}
+proc milestone {name} {
+    record [file join $::out stage.txt] "$name [clock format [clock seconds] -gmt 1 -format {%Y-%m-%dT%H:%M:%SZ}]"
+    puts "KV260_STAGE=$name"
+}
+proc timing_reports {phase} {
+    report_timing_summary -delay_type min_max -report_unconstrained -check_timing_verbose -file [file join $::out timing_${phase}.rpt]
+    report_timing -delay_type max -max_paths 20 -file [file join $::out paths_${phase}.rpt]
+    report_utilization -file [file join $::out utilization_${phase}.rpt]
+    report_utilization -hierarchical -hierarchical_depth 5 -file [file join $::out hierarchy_${phase}.rpt]
+}
+
+proc bus_skew_gate {out} {
+    # Bus skew is checked separately from report_timing_summary. With no scope
+    # filter, this summary includes every constraint, evaluated with min_max.
+    set skew [report_bus_skew -delay_type min_max -sort_by_slack -no_detailed_paths -return_string]
+    record [file join $out bus_skew.rpt] $skew
+    set xdc_path [file join $out inherited_constraints.xdc]
+    write_xdc -force $xdc_path
+    set f [open $xdc_path r]; set xdc [read $f]; close $f
+    set expected [regexp -all -line {^\s*set_bus_skew\s} $xdc]
+    set ids {}; set slacks {}; set inactive 0
+    foreach line [split $skew \n] {
+        if {[regexp {^\s*([0-9]+)\s+([0-9]+)\s+} $line unused id position]} {lappend ids $id}
+        if {[regexp {(Fast|Slow)\s+([-+0-9.]+)\s+([-+0-9.]+)\s+([-+0-9.]+)\s*$} $line unused corner requirement actual slack]} {lappend slacks $slack}
+        if {[regexp {NA\s+[-+0-9.]+\s+NA\s+NA\s*$} $line]} {incr inactive}
+    }
+    set count [llength $ids]
+    set worst NA
+    if {[llength $slacks]} {set worst [lindex [lsort -real $slacks] 0]}
+    record [file join $out bus_skew_metrics.txt] "XDC_CONSTRAINTS=$expected\nREPORTED_CONSTRAINTS=$count\nNUMERIC_RESULTS=[llength $slacks]\nINACTIVE_RESULTS=$inactive\nWORST_SLACK_NS=$worst"
+    if {$count != $expected || [llength [lsort -unique $ids]] != $count || [llength $slacks] != $count || $inactive} {
+        error "Incomplete bus-skew coverage; see bus_skew.rpt and inherited_constraints.xdc"
+    }
+    if {$worst ne "NA" && $worst < 0} {error "Routed bus skew fails; bitstream withheld"}
+    return [dict create constraints $count worst_slack $worst]
+}
+
+milestone create
+set board_repo [file join $::env(XILINX_VIVADO) data xhub boards XilinxBoardStore boards]
+if {[info exists ::env(BOARD_REPO)]} {set board_repo [file normalize $::env(BOARD_REPO)]}
+set_param board.repoPaths [list $board_repo]
+set board xilinx.com:kv260_som:part0:2.0
+one [get_board_parts -quiet $board] "official KV260 SOM preset"
+create_project -force opentpu_kv260 [file join $out project] -part xck26-sfvc784-2LV-c
+if {[info exists ::env(OTPU_KV260_IP_CACHE)]} {config_ip_cache -use_cache_location $::env(OTPU_KV260_IP_CACHE)}
+set_property board_part $board [current_project]
+set_property target_language Verilog [current_project]
+set_property simulator_language Mixed [current_project]
+set f [open [file join $out sources.txt] r]
+foreach rel [split [read $f] \n] {
+    if {$rel ne ""} {add_files -norecurse [file join $inputs $rel]}
+}
+close $f
+add_files -fileset constrs_1 -norecurse [file join $inputs boards/kv260/constraints/kv260.xdc]
+update_compile_order -fileset sources_1
+create_bd_design otpu_kv260_bd
+set ps [ip ps xilinx.com:ip:zynq_ultra_ps_e:3.5 {}]
+apply_bd_automation -rule xilinx.com:bd_rule:zynq_ultra_ps_e -config {apply_board_preset "1"} $ps
+set_property -dict [list \
+    CONFIG.PSU__FPGA_PL0_ENABLE 1 CONFIG.PSU__FPGA_PL1_ENABLE 0 \
+    CONFIG.PSU__FPGA_PL2_ENABLE 0 CONFIG.PSU__FPGA_PL3_ENABLE 0 \
+    CONFIG.PSU__CRL_APB__PL0_REF_CTRL__FREQMHZ 100 \
+    CONFIG.PSU__NUM_FABRIC_RESETS 1 CONFIG.PSU__USE__FABRIC__RST 1 \
+    CONFIG.PSU__USE__M_AXI_GP0 1 CONFIG.PSU__MAXIGP0__DATA_WIDTH 32 \
+    CONFIG.PSU__USE__M_AXI_GP1 0 CONFIG.PSU__USE__M_AXI_GP2 0 \
+    CONFIG.PSU__USE__S_AXI_GP0 1 CONFIG.PSU__SAXIGP0__DATA_WIDTH 128 \
+    CONFIG.PSU__USE__S_AXI_GP1 1 CONFIG.PSU__SAXIGP1__DATA_WIDTH 128 \
+    CONFIG.PSU__USE__S_AXI_GP2 0 CONFIG.PSU__USE__S_AXI_GP3 0 \
+    CONFIG.PSU__USE__S_AXI_GP4 0 CONFIG.PSU__USE__S_AXI_GP5 0 CONFIG.PSU__USE__S_AXI_GP6 0 \
+    CONFIG.PSU__USE__IRQ0 0 CONFIG.PSU__USE__IRQ1 0 \
+    CONFIG.PSU__GPIO_EMIO__PERIPHERAL__ENABLE 0 \
+    CONFIG.PSU__DISPLAYPORT__PERIPHERAL__ENABLE 0 CONFIG.PSU__DPAUX__PERIPHERAL__ENABLE 0] $ps
+set slow_hz [get_property CONFIG.FREQ_HZ [pin ps/pl_clk0]]
+ip coreClock xilinx.com:ip:clk_wiz:6.0 [list \
+    CONFIG.PRIM_SOURCE No_buffer CONFIG.PRIM_IN_FREQ [expr {$slow_hz/1000000.0}] \
+    CONFIG.JITTER_SEL Min_O_Jitter CONFIG.USE_MIN_O_JITTER true \
+    CONFIG.CLKOUT1_REQUESTED_OUT_FREQ $core_mhz CONFIG.USE_RESET true CONFIG.RESET_TYPE ACTIVE_LOW]
+ip zero xilinx.com:ip:xlconstant:1.1 [list CONFIG.CONST_WIDTH 1 CONFIG.CONST_VAL 0]
+foreach {name clock} {resetSlow ps/pl_clk0 resetCore coreClock/clk_out1} {
+    ip $name xilinx.com:ip:proc_sys_reset:5.0 [list CONFIG.C_AUX_RESET_HIGH 1 CONFIG.C_EXT_RESET_HIGH 0]
+    net $clock $name/slowest_sync_clk
+    net ps/pl_resetn0 $name/ext_reset_in
+    net zero/dout $name/aux_reset_in $name/mb_debug_sys_rst
+    net coreClock/locked $name/dcm_locked
+}
+net ps/pl_clk0 coreClock/clk_in1 ps/maxihpm0_fpd_aclk
+net ps/pl_resetn0 coreClock/resetn
+create_bd_cell -type module -reference otpu_kv260_core accelerator
+set core_hz [expr {round($core_mhz*1000000)}]
+set_property -dict [list CONFIG.CORE_KHZ [expr {$core_hz/1000}] CONFIG.BUILD_ID $build_id CONFIG.ARCH_HASH $arch_hash] [get_bd_cells accelerator]
+net coreClock/clk_out1 accelerator/clk ps/saxihpc0_fpd_aclk ps/saxihpc1_fpd_aclk
+net resetCore/peripheral_aresetn accelerator/resetn
+ip control xilinx.com:ip:smartconnect:1.0 [list CONFIG.NUM_SI 1 CONFIG.NUM_MI 1 CONFIG.NUM_CLKS 2]
+net ps/pl_clk0 control/aclk
+net coreClock/clk_out1 control/aclk1
+net resetSlow/peripheral_aresetn control/aresetn
+intf ps/M_AXI_HPM0_FPD control/S00_AXI
+intf control/M00_AXI accelerator/S_AXI_CTL
+for {set c 0} {$c < 2} {incr c} {
+    ip memory$c xilinx.com:ip:smartconnect:1.0 [list CONFIG.NUM_SI 1 CONFIG.NUM_MI 1]
+    net coreClock/clk_out1 memory$c/aclk
+    net resetCore/peripheral_aresetn memory$c/aresetn
+    intf accelerator/M_AXI_MEM$c memory$c/S00_AXI
+    intf memory$c/M00_AXI ps/S_AXI_HPC${c}_FPD
+    assign_bd_address -offset 0 -range 0x80000000 -force \
+        -target_address_space [get_bd_addr_spaces accelerator/M_AXI_MEM$c] \
+        [get_bd_addr_segs ps/SAXIGP${c}/HPC${c}_DDR_LOW]
+}
+assign_bd_address -offset 0xA0000000 -range 0x1000 -force \
+    -target_address_space [get_bd_addr_spaces ps/Data] \
+    [one [get_bd_addr_segs -of_objects [get_bd_intf_pins accelerator/S_AXI_CTL]] "accelerator register segment"]
+set fan [create_bd_port -dir O fan_en_b]
+connect_bd_net [pin zero/dout] $fan
+validate_bd_design
+save_bd_design
+write_bd_tcl -force [file join $out block_design.tcl]
+set bd [one [get_files -quiet */otpu_kv260_bd.bd] "block design"]
+generate_target all $bd
+set cache_usage {}
+foreach obj [get_ips] {
+    set def [get_property IPDEF $obj]
+    if {![string match "xilinx.com:module_ref:*" $def] && $def ni {xilinx.com:ip:xlconstant:1.1 xilinx.com:ip:xlconcat:2.1}} {
+        lappend cache_usage "$obj ID=[config_ip_cache -get_id $obj] USED=[config_ip_cache -cache_was_used $obj]"
+    }
+}
+record [file join $out vendor_ip_cache.txt] [join $cache_usage \n]
+make_wrapper -files $bd -top
+set wrapper [file join $out project opentpu_kv260.gen sources_1 bd otpu_kv260_bd hdl otpu_kv260_bd_wrapper.v]
+add_files -norecurse $wrapper
+set_property top otpu_kv260_bd_wrapper [current_fileset]
+update_compile_order -fileset sources_1
+record [file join $out contract.txt] "PART=xck26-sfvc784-2LV-c\nBOARD=$board\nVIVADO=[version -short]\nCORE_REQUESTED_HZ=$core_hz\nPS_REFERENCE_HZ=$slow_hz\nCONTROL_BASE=0xA0000000\nDDR_PHYSICAL_BASE=0x60000000\nDDR_BYTES=268435456\nPROGRAM_HARDWARE=0"
+milestone synthesis
+launch_runs synth_1 -jobs 3
+wait_on_run synth_1
+if {[get_property PROGRESS [get_runs synth_1]] ne "100%"} {error "Synthesis failed"}
+open_run synth_1
+write_checkpoint -force [file join $out synthesized.dcp]
+timing_reports synth
+set dsps [get_cells -hierarchical -quiet -filter {REF_NAME == DSP48E2}]
+if {[llength $dsps] < 256} {error "Missing native DSP48E2 matrix implementation: [llength $dsps]"}
+set urams [get_cells -hierarchical -quiet -filter {REF_NAME =~ URAM288*}]
+if {[llength $urams] != 32} {error "Expected 32 native activation UltraRAMs, got [llength $urams]"}
+if {[llength [get_cells -hierarchical -quiet -filter {IS_BLACKBOX == 1}]]} {error "Synthesis has black boxes"}
+if {$build_stage eq "synth"} {record [file join $out SYNTH_PASS] "Native synthesis passed"; exit 0}
+milestone optimize
+opt_design -directive Explore
+if {$incremental_reference} {
+    # The current source/clock constraints remain authoritative. This imports
+    # physical reuse guidance after optimizing the freshly synthesized design.
+    read_checkpoint -incremental -directive TimingClosure [file join $inputs implementation_reference.dcp]
+    report_incremental_reuse -file [file join $out incremental_reuse_initial.rpt]
+}
+milestone placement
+place_design -directive Explore
+phys_opt_design -directive AggressiveExplore
+write_checkpoint -force [file join $out placed.dcp]
+timing_reports place
+milestone routing
+if {$incremental_reference} {
+    # Explore is supported by Vivado's incremental/high-reuse router.
+    route_design -directive Explore
+} else {
+    route_design -directive AggressiveExplore
+}
+phys_opt_design -directive AggressiveExplore
+write_checkpoint -force [file join $out routed.dcp]
+if {$incremental_reference} {
+    report_incremental_reuse -file [file join $out incremental_reuse_route.rpt]
+}
+milestone signoff
+timing_reports route
+report_clock_utilization -file [file join $out clock_utilization.rpt]
+report_clocks -file [file join $out clocks.rpt]
+report_clock_interaction -file [file join $out clock_interaction.rpt]
+report_cdc -details -file [file join $out cdc.rpt]
+report_exceptions -file [file join $out exceptions.rpt]
+report_route_status -file [file join $out route_status.rpt]
+report_drc -file [file join $out drc.rpt]
+set check [check_timing -verbose -return_string]
+record [file join $out check_timing.rpt] $check
+set summary [report_timing_summary -delay_type min_max -report_unconstrained -check_timing_verbose -return_string]
+set fields {}
+set waiting 0
+foreach line [split $summary \n] {
+    if {[regexp {^\s*WNS\(ns\).*WPWS\(ns\)} $line]} {set waiting 1} elseif {$waiting && [regexp {^\s*[-+]?[0-9]+\.[0-9]+\s} $line]} {
+        set fields [regexp -all -inline {\S+} $line]; break
+    }
+}
+if {[llength $fields] != 12} {error "Cannot parse timing summary"}
+record [file join $out timing_metrics.txt] "CORE_MHZ=$core_mhz\nSETUP_WNS_NS=[lindex $fields 0]\nHOLD_WHS_NS=[lindex $fields 4]\nPULSE_WPWS_NS=[lindex $fields 8]\nSETUP_FAILING_ENDPOINTS=[lindex $fields 2]\nHOLD_FAILING_ENDPOINTS=[lindex $fields 6]\nPULSE_FAILING_ENDPOINTS=[lindex $fields 10]"
+foreach i {0 4 8} {
+    if {![string is double -strict [lindex $fields $i]] || [lindex $fields $i] < 0} {error "Routed timing fails; bitstream withheld"}
+}
+foreach i {2 6 10} {if {[lindex $fields $i] != 0} {error "Failing timing endpoints; bitstream withheld"}}
+foreach category {no_clock constant_clock pulse_width_clock unconstrained_internal_endpoints no_input_delay no_output_delay partial_input_delay partial_output_delay multiple_clock generated_clocks loops latch_loops} {
+    if {![regexp [format {checking %s \(([0-9]+)\)} $category] $check unused count] || $count != 0} {error "Timing coverage fails: $category"}
+}
+set errors [get_drc_violations -quiet -filter {SEVERITY == Error || SEVERITY == "Critical Warning"}]
+if {[llength $errors]} {error "Unresolved device-rule violations: $errors"}
+# Inspect every internal route status. Hierarchical segments may have no route
+# of their own, but must resolve to a routed segment; a net without loads needs
+# no physical route. Do not admit other states merely because they are not
+# spelled UNROUTED or PARTIAL.
+set exterior [get_nets -segments -of_objects [get_ports]]
+set route_counts [dict create]
+set route_failures {}
+foreach wire [get_nets -hierarchical] {
+    set state [get_property ROUTE_STATUS $wire]
+    dict incr route_counts $state
+    if {[lsearch -exact $exterior $wire] >= 0} {continue}
+    if {$state in {ROUTED INTRASITE}} {continue}
+    set loads [get_pins -quiet -leaf -of_objects $wire -filter {DIRECTION == IN}]
+    if {$state eq "NOLOADS" && ![llength $loads]} {continue}
+    if {$state eq "HIERPORT"} {
+        set resolved 0
+        foreach segment [get_nets -segments -of_objects [get_pins -quiet -of_objects $wire]] {
+            if {[get_property ROUTE_STATUS $segment] in {ROUTED INTRASITE}} {set resolved 1}
+        }
+        if {$resolved} {continue}
+    }
+    lappend route_failures "$wire $state LOADS=[llength $loads]"
+}
+record [file join $out routing_completeness.txt] "STATUS_COUNTS=$route_counts\nUNROUTED_INTERNAL_NETS=[llength $route_failures]\n[join $route_failures \n]"
+if {[llength $route_failures]} {error "Incomplete internal routing; see routing_completeness.txt"}
+set coreclk [one [get_clocks -of_objects [get_pins otpu_kv260_bd_i/accelerator/inst/clk]] "accelerator clock"]
+if {abs([get_property PERIOD $coreclk] - 1000.0/$core_mhz) > 0.001} {error "Incorrect accelerator clock period"}
+bus_skew_gate $out
+milestone bitstream
+write_bitstream -force -bin_file [file join $out opentpu_kv260.bit]
+# The implementation commands above run directly after open_run synth_1.
+# Export the fixed hardware description; its bitstream is the separate file
+# just generated. -include_bit requires a managed implementation-run bitfile.
+write_hw_platform -fixed -force -file [file join $out opentpu_kv260.xsa]
+record [file join $out PASS] "Routed setup, hold, pulse width, coverage, DRC and routing passed. Hardware not programmed."
+milestone complete
+exit 0
