+name = "kv260"
+kind = "fpga"
+platform_id = 3
+description = "Kria KV260, K26 UltraScale+, two HPC DDR paths, PS AXI-Lite control"
+
+[arch]
+S = 1
+D = 128
+MCOLS = 2
+ACT_BLOCKS = 64
+ACT_ROWS = 4
+TMEM_WORDS = 16384
+IMEM_WORDS = 16384
+DRAM_BYTES = 268435456
+LANES = 8
+PAIR = true
+DSTEP = true
+STREAM = true
+SEQ_WC = true
+
+[uarch]
+MXU_IMPL = 2
+MXU_CL = 16
+MXU_E = 2
+VPU_CL = 2
+ULANES = 4
+TMEM_IMPL = 3
+TMEM_NSB = 1
+TMEM_SBP = 3
+TMEM_SBH = 0
+TMEM_RPL = true
+TMEM_TDP = true
+TMEM_GST = true
+TMEM_PMP = 0
+TMEM_PRK = 0
+TMEM_SDM = -1
+IMEM_STYLE = "block"
+IMEM_WC_STYLE = "block"
+ACT_UCOLS = 2
+RPB = 0
+WPB = 1
+WIN = 16
+FIFO_DEPTH = 128
+TRACE_DEPTH = 0
+PQ_WIN = 1024
+CHASH = true
+NAT_RD = 32
+NAT_AD = 16
+NAT_APF = 8
+NAT_XD = 16
+NAT_WQD = 8
+NAT_FILL = false
+
+[tech]
+family = "xilinxus"
+vendor = "amd"
+part = "xck26-sfvc784-2LV-c"
+
+[platform]
+board = "kv260"
+core_mhz = 200.0
+mem = "ps-ddr4"
+channels_per_slice = 2
+channel_bytes = 134217728
+beat_bytes = 64
+host = "ps-axi"
